generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String           @id @default(cuid())
  email           String           @unique
  name            String
  passwordHash    String
  createdAt       DateTime         @default(now())
  memberships     Membership[]
  contributions   GoalContribution[]
  goalAllocations GoalAllocation[]
  transactions Transaction[]
}

model Partnership {
  id             String          @id @default(cuid())
  inviteCode     String          @unique
  createdAt      DateTime        @default(now())
  members        Membership[]
  accounts       Account[]
  goals          Goal[]
  transactions   Transaction[]
  lifePlans      LifePlan[]
  decisions      Decision[]
  reviewHistory  ReviewHistory[]
}

model Membership {
  userId        String
  partnershipId String
  joinedAt      DateTime    @default(now())
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  partnership   Partnership @relation(fields: [partnershipId], references: [id], onDelete: Cascade)

  @@id([userId, partnershipId])
}

model Account {
  id            String      @id @default(cuid())
  partnershipId String
  userId        String?     // owner of this account (used for relative Mine/Partner display)
  ownerLabel    String      @default("MINE") // kept for compatibility
  name          String
  type          String      // "CHECKING" | "SAVINGS" | "INVESTMENT" | "CREDIT" | "OTHER"
  balance       Float
  institution   String?
  createdAt     DateTime    @default(now())
  partnership   Partnership @relation(fields: [partnershipId], references: [id], onDelete: Cascade)
  transactions  Transaction[]
}

model Goal {
  id            String              @id @default(cuid())
  partnershipId String
  userId        String?
  ownerLabel    String              @default("JOINT")
  name          String
  type          String              @default("financial")
  targetAmount  Float
  currentAmount Float               @default(0)
  month         Int?
  category      String?
  completedAt   DateTime?
  targetDate    DateTime?
  notes         String?
  createdAt     DateTime            @default(now())
  partnership   Partnership         @relation(fields: [partnershipId], references: [id], onDelete: Cascade)
  contributions GoalContribution[]
  allocations   GoalAllocation[]
}

model GoalContribution {
  id        String   @id @default(cuid())
  goalId    String
  userId    String
  amount    Float
  createdAt DateTime @default(now())

  goal      Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@index([goalId])
  @@index([userId])
}

model GoalAllocation {
  id         String   @id @default(cuid())
  goalId     String
  userId     String
  percentage Int      // percentage of total goal this user is obligated for (0-100)

  goal       Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id])

  @@unique([goalId, userId])
  @@index([goalId])
  @@index([userId])
}

model Transaction {
  id            String      @id @default(cuid())
  partnershipId String
  userId        String
  accountId     String?
  amount        Float
  category      String
  date          DateTime
  description   String?
  merchant      String?
  createdAt     DateTime    @default(now())

  partnership   Partnership @relation(fields: [partnershipId], references: [id], onDelete: Cascade)
  account       Account?    @relation(fields: [accountId], references: [id], onDelete: SetNull)
  user          User        @relation(fields: [userId], references: [id])

  @@index([partnershipId])
  @@index([partnershipId, date])
  @@index([partnershipId, category])
  @@index([userId])
}

model Feedback {
  id            String    @id @default(cuid())
  userId        String
  partnershipId String?
  rating        Int       // 1, 2, or 3
  comment       String?
  page          String    // pathname where submitted, e.g. "/dashboard"
  userAgent     String?
  createdAt     DateTime  @default(now())

  @@index([page, createdAt])
  @@index([createdAt])
}

// Life Planning - stores shared vision from conversational flow
model LifePlan {
  id              String   @id @default(cuid())
  partnershipId   String
  visionStatement String   // The shared vision statement (1-2 sentences)
  roadmap         Json     // AI-generated 12-month action roadmap
  priorities      Json     // Ranked priorities from value conflict exercise
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  partnership     Partnership @relation(fields: [partnershipId], references: [id], onDelete: Cascade)

  @@index([partnershipId])
}

// Decisions logged from Monthly Review
model Decision {
  id              String   @id @default(cuid())
  partnershipId   String
  title           String   // Short title (e.g., "Hold off on car purchase")
  context         String   // What led to this decision
  outcome         String?  // Final decision text
  category        String   @default("OTHER") // SPENDING, TIMING, PRIORITY, OTHER
  createdAt       DateTime @default(now())

  partnership     Partnership @relation(fields: [partnershipId], references: [id], onDelete: Cascade)
  history         DecisionHistory[]

  @@index([partnershipId])
  @@index([createdAt])
}

// Track decision changes over time
model DecisionHistory {
  id              String   @id @default(cuid())
  decisionId      String
  previousOutcome String?
  newOutcome      String?
  reason          String?
  createdAt       DateTime @default(now())

  decision        Decision @relation(fields: [decisionId], references: [id], onDelete: Cascade)

  @@index([decisionId])
}

// Monthly Review tracking
model ReviewHistory {
  id               String   @id @default(cuid())
  partnershipId    String
  completedAt      DateTime @default(now())
  month            String   // "2026-04" format
  insight          String?  // The ONE insight discussed
  decisionsCreated Int      @default(0)
  mood             String?
  skipped          Boolean  @default(false)

  partnership      Partnership @relation(fields: [partnershipId], references: [id], onDelete: Cascade)

  @@unique([partnershipId, month])
  @@index([partnershipId])
}
